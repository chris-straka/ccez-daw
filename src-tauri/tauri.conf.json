{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ccez Daw",
  "version": "0.1.1",
  "identifier": "dev.ccez.daw",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ui && bun run dev",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/chris-straka/ccez-daw/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCOEVEMUIzMDJGRkUwQTQKUldTazRQOENzOUdPcS84QWwxb2xCNW1qOXVoclFhMDRxWlhTSC9JZEtvQWpyWjkyclRJdmVsUXkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
