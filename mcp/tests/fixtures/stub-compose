#!/usr/bin/env bun
// Stand-in for core's ccez-compose in TS-only CI: echoes what it was
// asked so tests can check the store's argument plumbing. Never audio.
const [cmd, doc, ...rest] = process.argv.slice(2);
const flag = (n: string) => {
  const i = rest.indexOf(n);
  return i >= 0 ? rest[i + 1] : undefined;
};
if (cmd === "validate") {
  const d = JSON.parse(await Bun.file(doc!).text());
  // Like the real CLI, a pitch serde can't read fails the whole load
  // (exit 1), not a validation error.
  const readable = (p: unknown) =>
    typeof p === "number" ? Number.isInteger(p) && p >= 0 && p <= 127 : /^[A-Ga-g][#b]?-?\d+$/.test(String(p).trim());
  for (const part of d.parts ?? []) {
    for (const n of part.notes ?? []) {
      if (!readable(n.pitch)) {
        console.error(`ccez-compose: ${doc}: pitch ${JSON.stringify(n.pitch)} is not a MIDI note 0..=127`);
        process.exit(1);
      }
    }
  }
  const errors = d.sections.length === 0 ? ["sections: need at least one loop section"] : [];
  console.log(JSON.stringify({ ok: errors.length === 0, errors }));
} else if (cmd === "patches") {
  const rows = [
    { id: "felt_piano", kind: "synth", family: "synth", description: "stub", range: [36, 96] },
    { id: "violins", kind: "sampled", family: "strings", description: "stub", range: [55, 86] },
  ];
  const fam = flag("--family") ?? (doc === "--family" ? rest[0] : undefined);
  console.log(JSON.stringify(rows.filter((r) => !fam || r.family === fam)));
} else if (cmd === "instrument" || cmd === "fetch") {
  console.log(JSON.stringify({ cmd, args: [doc, ...rest] }));
} else if (cmd === "preview" || cmd === "export") {
  const plan = flag("--plan");
  console.log(JSON.stringify({ cmd, out: flag("--out"), plan: plan ? JSON.parse(await Bun.file(plan).text()) : null }));
} else {
  console.error(`stub: unknown ${cmd}`);
  process.exit(1);
}
